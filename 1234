const W=320,H=200,cv=document.getElementById('c'),ctx=cv.getContext('2d'),ov=document.getElementById('ov'),sub=document.getElementById('sub');
cv.width=W;cv.height=H;
const img=ctx.createImageData(W,H),buf=new Uint32Array(img.data.buffer),zbuf=new Float32Array(W),fd=new Float32Array(W*H); // fd: depth of any fence bar drawn at each pixel
const rgb=(r,g,b)=>(255<<24)|((b|0)<<16)|((g|0)<<8)|(r|0);
const hash=(x,y,k)=>{let h=Math.imul(x+1,374761393)^Math.imul(y+1,668265263)^Math.imul(k+1,2246822519);h=Math.imul(h^(h>>>13),1274126177);return((h^(h>>>16))&255)/255};
let FK=1.35;const FCR=30,FCG=38,FCB=46;
const fog=d=>Math.min(1,Math.max(.05,1.3/(1+d*.8*FK)));
const shade=(c,f,L=1,w=0)=>{const g=1-f,fo=.2+.7*Math.min(1,L),mt=Math.max(0,1-L)*f; // fog scatters whatever light is there
 return(255<<24)|(Math.min(255,((c>>16)&255)*f*L*1.08+FCB*g*fo+14*mt)<<16)|(Math.min(255,((c>>8)&255)*f*L+FCG*g*fo+5*mt+20*w*f)<<8)|Math.min(255,(c&255)*f*L+FCR*g*fo+46*w*f)};

/* ---------- procedural placeholder wall textures (64x64) ---------- */
function makeTex(k){const t=new Uint32Array(4096);
 for(let y=0;y<64;y++)for(let x=0;x<64;x++){const n=hash(x,y,k);let r,g,b;
  if(k===1||k===4){const row=y>>4,bx=(x+(row&1)*16)%32,m=(y&15)===0||bx===0;
   let v=m?45:100+n*35+hash(x>>3,y>>3,k)*20;r=v;g=v;b=v*.95;
   if(k===4){r*=1.1;g*=.95;b*=.8}
   if(!m&&y>34&&hash(x>>2,y>>2,9)>.75){r=40+n*20;g=80+n*30;b=35}
  }else if(k===2){let v=85+n*25;if(x<3||x>60)v-=25;
   if((Math.abs(x-32)<3&&y>14&&y<52)||(Math.abs(y-26)<3&&Math.abs(x-32)<12))v=40;
   r=v;g=v*1.02;b=v*.95;if(y>52&&n>.5){r=40;g=85;b=35}
  }else if(k===3){const iron=(x&7)<3||(y>8&&y<12)||(y>50&&y<54);
   if(iron){const v=25+n*20;r=v;g=v;b=v*1.1}else{r=8;g=12;b=10}
  }else if(k===17){const bx=(x+2)&7,bar=bx<2,rail=(y>=9&&y<=11)||(y>=50&&y<=52),tip=y<9&&bx===0&&(y>=2||(x&8)===0);
   if((bar&&y>=(bx===0?0:6))||rail||tip){const v=20+n*14+(bx===0?26:0);r=v;g=v*1.03;b=v*1.15}else{t[y*64+x]=0;continue}
  }else if(k===5||k===16){const bar=(x&7)<3,rail=(y>=6&&y<=9)||(y>=30&&y<=33)||(y>=54&&y<=57);
   if(bar||rail){const v=34+n*26;r=v;g=v*1.04;b=v*1.12}else{t[y*64+x]=0;continue}
  }else{r=20+n*20;g=60+n*45;b=15+n*10;if(hash(x>>1,y>>1,7)>.82){g+=40}}
  t[y*64+x]=rgb(r,g,b)}
 return t}
const TEX={};[1,2,3,4,5,6,16,17].forEach(k=>TEX[k]=makeTex(k));
const TEXD=new Uint32Array(4096);for(let y=0;y<64;y++)for(let x=0;x<64;x++){const n=hash(x,y,21),p=hash(x>>1,y>>1,22);let v=.85+n*.3;if(p>.9)v*=1.25;else if(p<.08)v*=.7;TEXD[y*64+x]=rgb(100*v,76*v,50*v)}
/* 7 = secret wall (looks like plain stone, slides open), 8/9 = hidden lever up/down (stone with a small iron lever) */
function leverTex(up){const t=TEX[1].slice(),px=(x,y,c)=>{t[y*64+x]=c},ey=up?23:45;
 for(let y=19;y<48;y++)for(let x=24;x<40;x++)px(x,y,rgb(34,34,38));
 for(let y=21;y<46;y++)for(let x=26;x<38;x++)px(x,y,rgb(56,56,60));
 for(let y=27;y<41;y++){px(31,y,rgb(14,14,16));px(32,y,rgb(14,14,16))}
 for(let y=Math.min(34,ey);y<=Math.max(34,ey);y++){px(31,y,rgb(110,108,104));px(32,y,rgb(150,146,140));px(33,y,rgb(84,82,80))}
 for(let dy=-3;dy<=3;dy++)for(let dx=-3;dx<=3;dx++)if(dx*dx+dy*dy<=9)px(32+dx,ey+dy,rgb(150,52,36));
 return t}
TEX[7]=TEX[1];TEX[8]=leverTex(true);TEX[9]=leverTex(false);TEX[19]=TEX[8];TEX[20]=TEX[9]; // 19/20 = second lever (up/down)
/* vines: hang from the top of stone wall faces; 0 = no vine (stone shows through) */
const VIN=[];(function(){for(let v=0;v<8;v++){const t=new Uint32Array(4096),px=(x,y,c)=>{if(x>=0&&x<64&&y>=0&&y<64)t[y*64+x]=c},k=300+v*17,nv=2+((hash(v,1,k)*3)|0);
 for(let n=0;n<nv;n++){const x0=6+((hash(v,n,k+1)*52)|0),len=16+((hash(v,n,k+2)*40)|0),ph=hash(v,n,k+3)*6.28,wid=hash(v,n,k+4)>.55?2:1;
  for(let y=0;y<len;y++){const xx=x0+Math.round(Math.sin(y*.22+ph)*1.6),fade=y>len-6?.7:1,nn=hash(xx,y,k+5);
   for(let w=0;w<wid;w++)px(xx+w,y,rgb((26+nn*16)*fade,(62+nn*30)*fade,(22+nn*10)*fade));
   if(y>3&&y%6===(n%3)+1&&y<len-2){const s=hash(y,n,k+6)>.5?1:-1;for(let q=1;q<=3;q++)px(xx+s*q,y+(q>>1),rgb(34+nn*18,92+nn*40,30));px(xx+s*2,y-1,rgb(48,118,40))}}}
 for(let x=0;x<64;x++)if(hash(x>>1,v,k+7)>.45){const d=1+((hash(x,v,k+8)*4)|0);for(let y=0;y<d;y++)px(x,y,rgb(28+hash(x,y,k+9)*20,76+hash(x,y,k+10)*40,26))}
 VIN.push(t)}})();
function vineFor(h,rdx,rdy){const f=h.side*2+(h.side===0?(rdx>0?0:1):(rdy>0?0:1)),q=hash(h.mx*7+f,h.my*5+f*3,411);return q<.38?null:VIN[Math.min(VIN.length-1,(((q-.38)/.62)*VIN.length)|0)]}

/* ---------- sprites: placeholders. Swap with your own via loadSprite() ---------- */
function makeSprite(w,h,draw){const c=document.createElement('canvas');c.width=w;c.height=h;const g=c.getContext('2d');draw(g);
 return{w,h,d:new Uint32Array(g.getImageData(0,0,w,h).data.buffer)}}
const SPR={
 zombie:makeSprite(32,48,g=>{g.fillStyle='#6e965a';g.fillRect(11,2,10,10);g.fillRect(2,13,8,4);g.fillRect(22,13,8,4);
  g.fillStyle='#d22';g.fillRect(13,5,2,2);g.fillRect(17,5,2,2);g.fillStyle='#463c32';g.fillRect(9,12,14,18);
  g.fillStyle='#323750';g.fillRect(10,30,5,16);g.fillRect(17,30,5,16)}),
 key:makeSprite(16,16,g=>{g.fillStyle='#e6be3c';g.fillRect(1,1,6,6);g.clearRect(3,3,2,2);g.fillRect(6,3,9,2);g.fillRect(11,5,2,3);g.fillRect(14,5,2,2)})
};
/* To use your own art: loadSprite('zombie','data:image/png;base64,...') or a URL. Any size works. */
function loadSprite(name,url){const im=new Image();im.onload=()=>{SPR[name]=makeSprite(im.width,im.height,g=>g.drawImage(im,0,0))};im.src=url}

SPR.gunpick=makeSprite(16,16,g=>{g.fillStyle='#555';g.fillRect(2,5,11,3);g.fillStyle='#8a8a8a';g.fillRect(2,5,11,1);g.fillStyle='#3a2a1a';g.fillRect(9,8,3,6);g.fillStyle='#444';g.fillRect(6,8,3,1);g.fillStyle='#222';g.fillRect(1,6,1,1)});
SPR.ammo=makeSprite(16,16,g=>{g.fillStyle='#4a3b2a';g.fillRect(1,7,14,8);g.fillStyle='#6b5438';g.fillRect(1,7,14,2);
 for(let k=0;k<3;k++){g.fillStyle='#c9a227';g.fillRect(2+k*4,3,3,6);g.fillStyle='#8a8a8a';g.fillRect(2+k*4,1,3,2)}});
SPR.bat=makeSprite(16,16,g=>{g.fillStyle='#3a3a40';g.fillRect(3,3,10,12);g.fillStyle='#8fd14f';g.fillRect(4,6,8,8);g.fillStyle='#d8d8d8';g.fillRect(6,1,4,2);g.fillStyle='#1f2a14';g.fillRect(7,8,2,5);g.fillRect(5,10,6,1)});
SPR.exitlamp=makeSprite(20,64,g=>{g.fillStyle='#2a2c30';g.fillRect(9,15,3,47);g.fillRect(6,60,9,4);g.fillRect(4,0,13,3);g.fillRect(5,14,11,2);g.fillRect(4,3,2,11);g.fillRect(15,3,2,11);g.fillStyle='#9dffa0';g.fillRect(6,3,9,11);g.fillStyle='#e8ffe0';g.fillRect(8,6,5,5)});
SPR.candle=makeSprite(8,14,g=>{g.fillStyle='#8a7f60';g.fillRect(1,13,6,1);g.fillStyle='#e8e0c8';g.fillRect(2,5,4,8);g.fillStyle='#b8ae90';g.fillRect(5,5,1,8);g.fillStyle='#cfc6a8';g.fillRect(2,8,1,3);g.fillStyle='#222';g.fillRect(3,4,1,1);g.fillStyle='#ff8a20';g.fillRect(3,0,2,1);g.fillStyle='#ffb830';g.fillRect(3,1,2,3);g.fillStyle='#fff2a0';g.fillRect(3,2,1,2)});
SPR.sign=makeSprite(24,44,g=>{g.fillStyle='#2a1c0e';g.fillRect(10,15,4,29);g.fillStyle='#3e2a16';g.fillRect(10,15,1,29);g.fillRect(8,43,8,1);
 g.fillStyle='#1c1208';g.fillRect(0,1,24,16);g.fillStyle='#5a3e22';g.fillRect(1,2,22,14);g.fillStyle='#4a3218';g.fillRect(1,6,22,1);g.fillRect(1,10,22,1);g.fillRect(1,14,22,1);
 g.fillStyle='#e8d9b0';[[4,4,16],[4,8,12],[4,12,15]].forEach(([x,y,w])=>g.fillRect(x,y,w,1));g.fillStyle='#9a8a6a';g.fillRect(2,3,1,1);g.fillRect(21,3,1,1);g.fillRect(2,13,1,1);g.fillRect(21,13,1,1)});
/* decor sprites: shrubs, cobweb, spider (2 leg frames) */
const WEBW=36,WEBH=38;
const mkShrub=(w,h,blobs,seed)=>makeSprite(w,h,g=>{let s=seed;const rnd=()=>{s=(s*16807)%2147483647;return s/2147483647},put=(x,y,c)=>{g.fillStyle=c;g.fillRect(x|0,y|0,1,1)};
 for(const[cx,cy,rx,ry]of blobs)for(let y=Math.floor(cy-ry);y<=cy+ry;y++)for(let x=Math.floor(cx-rx);x<=cx+rx;x++){const dx=(x-cx)/rx,dy=(y-cy)/ry;if(dx*dx+dy*dy>1)continue;
  const top=(cy-y)/ry;let c=top>.55?'#4f8a52':top>.1?'#3c6e41':top>-.5?'#2c5232':'#1e3a25';if(rnd()<.18)c=top>0?'#5f9a5a':'#173020';put(x,y,c)}
 for(let x=0;x<w;x++)if(rnd()<.5)put(x,h-1,'#142a1b')});
/* dead, beaten hedges: a tangle of bare thorny branches, some snapped, some drooping, with a few dried leaves and a litter mound */
const mkDead=(w,h,seed,nb)=>makeSprite(w,h,g=>{let s=seed;const rnd=()=>{s=(s*16807)%2147483647;return s/2147483647},put=(x,y,c)=>{x=Math.round(x);y=Math.round(y);if(x>=0&&y>=0&&x<w&&y<h){g.fillStyle=c;g.fillRect(x,y,1,1)}};
 const BK=['#4a4034','#5c5043','#6f6252'],HL='#9a8c72',LF=['#7a6a3a','#5e5230','#8a7440'];
 for(let x=1;x<w-1;x++){const t=Math.abs(x-w/2)/(w/2),mh=Math.round((1-t*t)*3);for(let y=0;y<=mh;y++)put(x,h-1-y,rnd()<.5?'#2e261a':'#3d3324')}
 const twig=(x,y,a,len,th,d,droop)=>{let px=x,py=y;for(let i=0;i<len;i++){a+=(rnd()-.5)*.5;if(rnd()<.03)a+=(rnd()<.5?-1:1)*.9;if(droop&&i>len*.45)a+=(Math.PI/2-a)*.1;
   px+=Math.cos(a);py+=Math.sin(a);const thick=th>1&&i<len*.6;put(px,py,thick?BK[0]:BK[(rnd()*3)|0]);if(thick)put(px+1,py,BK[1]);else if(rnd()<.3)put(px-1,py,HL);
   if(d<3&&i>3&&i<len-3&&rnd()<.2)twig(px,py,a+(rnd()<.5?-1:1)*(.5+rnd()*.8),len*(.28+rnd()*.3),1,d+1,droop&&rnd()<.5); // pointy side twigs
   if(rnd()<.06)put(px+(rnd()<.5?-1:1),py+(rnd()<.5?0:1),LF[(rnd()*3)|0])}};
 for(let i=0;i<nb;i++){const x0=w*(.12+.76*rnd()),a=-Math.PI/2+(x0-w/2)/w*1.7+(rnd()-.5)*.6,len=h*(.55+rnd()*.5)*(rnd()<.2?.4:1);twig(x0,h-3,a,len,2,0,rnd()<.3)}
 for(let i=0;i<nb;i++){const x=2+rnd()*(w-4),y=h-3-rnd()*3;put(x,y,LF[(rnd()*3)|0]);put(x+1,y,LF[(rnd()*3)|0])}});
SPR.shrub0=mkDead(68,40,11,14);
SPR.shrub1=mkDead(40,52,23,8);
SPR.shrub2=mkDead(52,28,37,12);
SPR.web=makeSprite(WEBW,WEBH,g=>{const put=(x,y,c)=>{g.fillStyle=c;g.fillRect(x|0,y|0,1,1)},
 ln=(x0,y0,x1,y1,c)=>{const n=Math.max(Math.abs(x1-x0),Math.abs(y1-y0))|0;for(let i=0;i<=n;i++){const t=n?i/n:0;put(Math.round(x0+(x1-x0)*t),Math.round(y0+(y1-y0)*t),c)}},
 ax=17.5,ay=0,A=[-60,-40,-20,0,20,40,60].map(d=>d*Math.PI/180),Ln=a=>Math.min(37,17/Math.max(.001,Math.abs(Math.sin(a)))),pt=(a,f)=>[ax+Math.sin(a)*Ln(a)*f,ay+Math.cos(a)*Ln(a)*f];
 A.forEach((a,i)=>{const[ex,ey]=pt(a,1);ln(ax,ay,ex,ey,i%2?'#aeb4bc':'#c8ccd2')});
 for(const f of[.25,.42,.6,.78,.95])for(let i=0;i<A.length-1;i++){const[x0,y0]=pt(A[i],f),[x1,y1]=pt(A[i+1],f),mx=(x0+x1)/2+(ax-(x0+x1)/2)*.12,my=(y0+y1)/2+(ay-(y0+y1)/2)*.12;ln(x0,y0,mx,my,'#aab0b8');ln(mx,my,x1,y1,'#aab0b8')}});
const mkSpider=ph=>makeSprite(11,8,g=>{const put=(x,y,c)=>{g.fillStyle=c;g.fillRect(x,y,1,1)},
