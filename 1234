 const fend=()=>{keys.Space=false};F.addEventListener('pointerup',fend);F.addEventListener('pointercancel',fend);
 B.addEventListener('pointerdown',e=>{if(state==='play')use();else if(state==='read')closeRead();e.preventDefault()});
})();
function pryNear(){const cs=Math.cos(ang),sn=Math.sin(ang);for(const e of ents)if(e.type==='wood'&&e.planks>0){const dx=e.x-P.x,dy=e.y-P.y,d=Math.hypot(dx,dy);if(d<1.5&&(dx*cs+dy*sn)/(d||1)>.3){dismantle(e);return true}}return false}
/* pixel-art arcade controls: sprites are drawn pixel by pixel, then scaled up with nearest-neighbour */
(function pixUI(){
 const mk=(w,h,fn)=>{const c=document.createElement('canvas');c.width=w;c.height=h;const g=c.getContext('2d');for(let y=0;y<h;y++)for(let x=0;x<w;x++){const col=fn(x,y);if(col){g.fillStyle=col;g.fillRect(x,y,1,1)}}return 'url('+c.toDataURL()+')'};
 const arrow=(dx,dy)=>{for(let r=0;r<4;r++){const[rx,ry]=[[dx,dy],[dy,-dx],[-dx,-dy],[-dy,dx]][r];if((ry===-8.5&&Math.abs(rx)<=.5)||(ry===-7.5&&Math.abs(rx)<=1.5)||(ry===-6.5&&Math.abs(rx)<=2.5))return true}return false};
 const base=mk(24,24,(x,y)=>{const dx=x-11.5,dy=y-11.5,d=Math.hypot(dx,dy);if(d>11.6)return null;if(d>10.4)return'#0b0d0e';if(d>9.3)return dx+dy<0?'#8a9099':'#434850';if(arrow(dx,dy))return'#7d848d';if(d<3.2)return'#101214';if(d<4.4)return'#3a3f46';return(x+y)%2?'#292d32':'#262a2f'});
 const knob=mk(14,14,(x,y)=>{const dx=x-6.5,dy=y-6.5,d=Math.hypot(dx,dy);if(d>6.9)return null;if(d>6)return'#3d0808';if((x===3||x===4)&&(y===3||y===4))return'#ffd0c4';if(dx+dy<-3&&d<5)return'#ee5a4a';if(dx+dy>3.5)return'#8e1c18';return'#c9332b'});
 const btn=(b,rim,lt,sh)=>mk(16,16,(x,y)=>{const dx=x-7.5,dy=y-7.5,d=Math.hypot(dx,dy);if(d>7.7)return null;if(d>6.5)return rim;if(dx+dy<-4.5&&d<5.6)return lt;if(dx+dy>4.5)return sh;return b});
 const set=(id,img)=>{const el=document.getElementById(id);if(el)el.style.backgroundImage=img};
 set('joy',base);set('knob',knob);
 set('fire',btn('#d8392a','#4a0e08','#ff8f78','#8f1d14'));set('use',btn('#e0b232','#4f3a08','#ffe68a','#8c6a12'));
 set('swap',btn('#4a7fd0','#12254d','#a4ccff','#274a8c'));set('jrn',btn('#d6c79c','#3d2f16','#f8efd2','#8c7a4a'));
 document.querySelectorAll('.tbtn').forEach(b=>{const on=()=>b.classList.add('dn'),off=()=>b.classList.remove('dn');b.addEventListener('pointerdown',on);b.addEventListener('pointerup',off);b.addEventListener('pointercancel',off);b.addEventListener('lostpointercapture',off)});
})();
document.getElementById('swap').addEventListener('pointerdown',e=>{swap();e.preventDefault()});
document.getElementById('jrn').addEventListener('pointerdown',e=>{if(jr.style.display==='flex')closeJournal();else openJournal();e.preventDefault()});
document.getElementById('jbtn').addEventListener('click',e=>{e.stopPropagation();openJournal()});
document.getElementById('jclose').addEventListener('click',e=>{e.stopPropagation();closeJournal()});
init();
