 L.addEventListener('pointerdown',e=>{if(state==='read')closeRead();lid=e.pointerId;L.setPointerCapture(lid);lx=e.clientX});
 L.addEventListener('pointermove',e=>{if(e.pointerId===lid){if(state==='play')ang+=(e.clientX-lx)*.008;lx=e.clientX}});
 const lend=e=>{if(e.pointerId===lid)lid=null};
 L.addEventListener('pointerup',lend);L.addEventListener('pointercancel',lend);
